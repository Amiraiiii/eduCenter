# 🤖 Google Gemini API Key (для серверного RAG AI-консультанта)
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 📁 Google Drive Integration (автосинхронизация базы знаний RAG)
# 1. ID папки на Google Диске (из ссылки drive.google.com/drive/folders/<FOLDER_ID>):
GOOGLE_DRIVE_FOLDER_ID=
# 2. API Ключ с включенным Google Drive API (если отличается от GEMINI_API_KEY):
GOOGLE_DRIVE_API_KEY=
# 3. Секретный токен для защиты вызова /api/sync-drive (опционально):
SYNC_SECRET_TOKEN=

# 📱 Telegram Bot Integration (для мгновенной отправки заявок с сайта менеджерам)
# 1. Создать бота в @BotFather и получить токен:
TELEGRAM_BOT_TOKEN=
# 2. Получить ID чата или группы (куда слать заявки):
TELEGRAM_CHAT_ID=

# 🌐 Базовый URL приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000
